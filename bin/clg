#!/usr/bin/env python3
"""clg — Claude Code hybride : chat principal sur Opus Anthropic réel,
sub-agents sur GPT via claude-code-proxy, multi-comptes ChatGPT Pro.

Routage modèle (via un routeur partagé adaptatif par défaut) :
  chat principal            -> claude-opus-5[1m] (api.anthropic.com, OAuth Max, 1M ctx)
  sub-agents opus/fable     -> gpt-5.6-sol       (proxy Codex)
  sub-agents sonnet         -> gpt-5.6-terra     (proxy Codex)
  sub-agents haiku          -> gpt-5.6-luna      (proxy Codex)
  sub-agents sans modèle    -> gpt-5.6-terra     (le tier sonnet est résolu ; natifs
                               et customs hors chat principal partent sur GPT)

Le chat principal reste sur un vrai modèle Anthropic pour que la compaction et
le reste du harness Claude Code se comportent normalement ; tout le travail
délégué part sur les modèles GPT du proxy. Le routeur partagé distribue chaque
requête proxy entre tous les comptes authentifiés, limite leur concurrence par
AIMD et retente un rejet WebSocket 403 sur un autre compte.

Usage:
  clg [args claude...]              routeur partagé entre tous les comptes authentifiés
  clg @b [args claude...]           force le compte "b" (routeur mono-upstream)
  clg @auto [args claude...]        équivalent au routeur partagé par défaut
  clg @list                         état des comptes + proxies
  CLG_ACCOUNT=b clg ...             équivalent à clg @b

Comptes gérés par `clg-account add <nom>` : une instance de proxy par compte,
chacune sur son propre port (CCP_CONFIG_DIR isole l'auth). Chaque compte a son
propre plafond de sessions Codex ; le scheduler additionne leur capacité sans
laisser un rejet "WebSocket upgrade was rejected" tuer un sub-agent.

L'OAuth Anthropic est lu dans le Keychain ("Claude Code-credentials") à chaque
requête opus. S'il expire, lancer une session `claude` normale le rafraîchit.
"""
import http.client
import json
import os
import pathlib
import random
import signal
import shutil
import subprocess
import sys
import threading
import time
import urllib.request
from dataclasses import dataclass
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from typing import Callable

HOME = pathlib.Path.home()
CFG_DIR = HOME / ".config" / "clg"
REGISTRY = CFG_DIR / "accounts.json"
ROUTING_FILE = CFG_DIR / "fleet" / "gpt" / "routing.json"
STATE_DIR = pathlib.Path(os.environ.get("XDG_STATE_HOME", str(HOME / ".local/state"))) / "claude-code-proxy"
PROXY_BIN = shutil.which("claude-code-proxy") or "/opt/homebrew/bin/claude-code-proxy"
BREW_FORMULA = "raine/claude-code-proxy/claude-code-proxy"
DEFAULT_REGISTRY = {
    "a": {"dir": str(HOME / ".config/claude-code-proxy"), "port": 18765, "brew": True},
}

ROUTER_PORT_OFFSET = 10000
SHARED_ROUTER_PORT = 28700
MAX_REQUEST_BODY_BYTES = 64 * 1024 * 1024
SOCKET_READ_TIMEOUT_SECONDS = 600
PINNED_UPSTREAM_HEADER = "X-CLG-Pinned-Upstream"
INITIAL_PERMITS = 6
MIN_PERMITS = 2
MAX_PERMITS = 12
AIMD_DECREASE_FACTOR = 0.75
SUCCESS_WINDOW = 20
MAX_PROXY_ATTEMPTS = 4
# Statuts Anthropic sur lesquels une compaction bascule sur GPT plutôt que
# d'échouer. Uniquement de la capacité (quota, surcharge) : une erreur d'auth
# doit rester visible, la masquer par un repli rendrait le problème indébogable.
COMPACTION_FALLBACK_STATUSES = (429, 529)
COMPACTION_ANTHROPIC_ATTEMPTS = 3
ACQUIRE_TIMEOUT_SECONDS = 300.0
RETRY_BODY_LIMIT = 65536
RETRY_BASE_SECONDS = 0.4
RETRY_JITTER_SECONDS = 0.3
# Défauts de routage. Ils restent la référence : tant que routing.json est absent
# ou illisible, clg se comporte exactement comme avant son externalisation.
# `clgctl config` est le seul outil qui écrit ce fichier.
# [1m] force la fenêtre de contexte 1M côté CLI (sinon l'auth "API" clampe à
# 200k -> compaction permanente). Vérifié : l'API accepte >400k tokens en OAuth
# Max sur claude-opus-5. Le routeur retire le suffixe avant l'envoi.
DEFAULT_ROUTING = {
    "main_model": "claude-opus-5",
    "main_model_env": "claude-opus-5[1m]",
    # Modèle Anthropic servant la compaction. Claude est entraîné pour cette
    # tâche précise, et le résumé conditionne toute la suite de la session :
    # c'est la dernière surface qu'on veut voir dégrader. Elle reste donc sur
    # Anthropic même quand tout le reste — chat principal compris — est GPT.
    "compact_model": "claude-opus-5",
    # Où va le chat principal : "anthropic" (défaut) ou "gpt". La compaction
    # ne suit pas ce réglage, elle est toujours servie par compact_model.
    "main_chat": "anthropic",
    # Fenêtre annoncée à Claude Code quand le chat tourne sur GPT. Sans elle, le
    # CLI ne reconnaît pas le modèle, avertit à chaque lancement et suppose 200k.
    # 272k est la fenêtre de toute la famille gpt-5.x au catalogue Codex : le 1M
    # est celle d'Opus, pas celle des modèles du proxy. Jamais exportée en mode
    # anthropic, où elle écraserait justement ce 1M.
    "main_context_tokens": "272000",
    # Taux de remplissage du contexte déclenchant l'auto-compaction, en pour
    # cent. Plus la valeur est haute, plus la compaction est tardive et rare.
    # Vide = on laisse le CLI décider.
    "autocompact_pct": "90",
    "tiers": {
        "opus": "gpt-5.6-sol",
        "sonnet": "gpt-5.6-terra",
        "haiku": "gpt-5.6-luna",
        "inherited": "gpt-5.6-terra",
    },
    "overrides": {},
}


def load_routing(account: str | None = None) -> dict:
    """Config de routage effective, surcharge de compte appliquée.

    Un fichier absent ou cassé ne doit jamais empêcher de lancer Claude Code :
    on retombe sur les défauts, mais bruyamment — un routage silencieusement
    ignoré est pire qu'un routage refusé.
    """
    cfg = {
        "main_model": DEFAULT_ROUTING["main_model"],
        "main_model_env": DEFAULT_ROUTING["main_model_env"],
        "compact_model": DEFAULT_ROUTING["compact_model"],
        "main_chat": DEFAULT_ROUTING["main_chat"],
        "main_context_tokens": DEFAULT_ROUTING["main_context_tokens"],
        "autocompact_pct": DEFAULT_ROUTING["autocompact_pct"],
        "tiers": dict(DEFAULT_ROUTING["tiers"]),
        "overrides": {},
    }
    try:
        raw = json.loads(ROUTING_FILE.read_text())
        for key in ("main_model", "main_model_env", "compact_model", "main_context_tokens",
                    "autocompact_pct"):
            value = raw.get(key)
            if isinstance(value, str) and value.strip():
                cfg[key] = value
        # Une valeur inconnue ne doit pas router au hasard : on garde le défaut
        # et on le dit, plutôt que de deviner ce que l'utilisateur voulait.
        main_chat = raw.get("main_chat")
        if isinstance(main_chat, str) and main_chat.strip():
            if main_chat in ("anthropic", "gpt"):
                cfg["main_chat"] = main_chat
            else:
                print(
                    f"clg: main_chat={main_chat!r} inconnu (anthropic|gpt) — "
                    f"{cfg['main_chat']!r} conservé.",
                    file=sys.stderr,
                )
        for tier, model in (raw.get("tiers") or {}).items():
            if tier in cfg["tiers"] and isinstance(model, str) and model.strip():
                cfg["tiers"][tier] = model
        overrides = raw.get("overrides")
        cfg["overrides"] = overrides if isinstance(overrides, dict) else {}
    except FileNotFoundError:
        pass
    except Exception as exc:
        print(f"clg: routing.json illisible ({exc}) — défauts appliqués.", file=sys.stderr)
    if account:
        tiers = ((cfg["overrides"].get(account.lstrip("@")) or {}).get("tiers")) or {}
        for tier, model in tiers.items():
            if tier in cfg["tiers"] and isinstance(model, str) and model.strip():
                cfg["tiers"][tier] = model
    return cfg


ROUTING = load_routing()
MAIN_MODEL = ROUTING["main_model"]
MAIN_MODEL_ENV = ROUTING["main_model_env"]
COMPACT_MODEL = ROUTING["compact_model"]
MAIN_CHAT_UPSTREAM = ROUTING["main_chat"]
# Whitelist : deux surfaces seulement peuvent aller chez Anthropic, et elles
# sont distinguées séparément parce qu'elles se configurent séparément. Les
# blocs system observés sont [billing-header, identité, corps] et l'identité est
# partagée par main et sub-agents — le discriminant fiable est le corps. Tout le
# reste (sub-agents natifs "You are an agent for...", customs avec leur propre
# prompt) part sur GPT.
MAIN_SYSTEM_MARKERS = ("You are an interactive agent",)
# Vérifié dans le binaire Claude Code 2.1.228 : la compaction envoie un bloc
# system unique, `systemPrompt: of(["You are a helpful AI assistant tasked with
# summarizing conversations."])`. Ce marqueur n'apparaît jamais dans les logs
# tant que le chat principal tourne en 1M — la compaction ne se déclenche pas.
COMPACTION_MARKERS = ("You are a helpful AI assistant tasked with summarizing conversations",)
SOL = ROUTING["tiers"]["opus"]
TERRA = ROUTING["tiers"]["sonnet"]
LUNA = ROUTING["tiers"]["haiku"]
INHERITED = ROUTING["tiers"]["inherited"]
# Seuls les noms déjà GPT traversent le routeur sans traduction.
GPT_PREFIX = "gpt-"
ANTHROPIC_HOST = "api.anthropic.com"
OAUTH_BETA = "oauth-2025-04-20"


def load_registry(kind: str | None = "proxy") -> dict:
    """Comptes du registre, filtrés par surface.

    Le registre est partagé avec clgctl, qui y range aussi des comptes Claude
    Code et Codex. Seuls les comptes `proxy` sont des upstreams : une entrée
    d'une autre surface n'a pas de port, et serait planifiée vers un port mort.
    Une entrée sans `kind` date d'avant les autres surfaces : c'est un proxy.
    """
    reg = json.loads(REGISTRY.read_text()) if REGISTRY.exists() else {}
    for name, acc in DEFAULT_REGISTRY.items():
        reg.setdefault(name, acc)
    if kind is None:
        return reg
    return {name: acc for name, acc in reg.items() if acc.get("kind", "proxy") == kind}


# ---------------------------------------------------------------------------
# Routeur local : opus du chat -> Anthropic, tout le reste -> proxy Codex.
# ---------------------------------------------------------------------------

_token_cache: tuple[str | None, float] | None = None
_token_lock = threading.Lock()


def read_oauth() -> dict:
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
            capture_output=True, text=True, timeout=10,
        )
        if out.returncode == 0:
            return json.loads(out.stdout.strip()).get("claudeAiOauth") or {}
    except Exception:
        pass
    try:
        data = json.loads((HOME / ".claude/.credentials.json").read_text())
        return data.get("claudeAiOauth") or {}
    except Exception:
        return {}


def oauth_token() -> str | None:
    global _token_cache
    with _token_lock:
        now = time.time()
        if _token_cache and now - _token_cache[1] < 60:
            return _token_cache[0]
        token = read_oauth().get("accessToken")
        _token_cache = (token, now)
        return token


def invalidate_oauth_token(token: str) -> None:
    global _token_cache
    with _token_lock:
        if _token_cache is not None and _token_cache[0] == token:
            _token_cache = None


def system_blocks(payload: dict) -> list[str]:
    system = payload.get("system")
    if isinstance(system, str):
        return [system]
    if isinstance(system, list):
        return [text for block in system if isinstance(block, dict)
                if isinstance((text := block.get("text")), str)]
    return []


def _has_marker(payload: dict, markers: tuple[str, ...]) -> bool:
    for block in system_blocks(payload)[:4]:
        if any(marker in block[:500] for marker in markers):
            return True
    return False


def main_chat_request(payload: dict) -> bool:
    """Vrai si la requête vient de la boucle du chat principal."""
    return _has_marker(payload, MAIN_SYSTEM_MARKERS)


def compaction_request(payload: dict) -> bool:
    """Vrai si la requête est une compaction de conversation."""
    return _has_marker(payload, COMPACTION_MARKERS)


def gpt_model_for(model: str) -> str:
    """Modèle GPT servant `model` côté proxy.

    Fail-closed : on n'énumère que ce qui a le droit de passer tel quel (les
    `gpt-*`), tout le reste est traduit vers un tier. L'inverse — laisser filer
    le nom d'origine — est ce qui envoyait `claude-sonnet-5` et
    `claude-haiku-4-5-*` au proxy, qui choisissait alors le modèle réel
    lui-même, hors de routing.json. Le proxy sert aussi grok/kimi/deepseek/glm :
    un nom inconnu doit atterrir sur un GPT, jamais être relayé au hasard.
    """
    if model.startswith(GPT_PREFIX):
        return model
    if model == MAIN_MODEL:
        # Sub-agent — natif ou custom — qui hérite du modèle du chat principal.
        return INHERITED
    name = model.lower()
    if "opus" in name or "fable" in name:
        return SOL
    if "sonnet" in name:
        return TERRA
    if "haiku" in name:
        return LUNA
    return INHERITED


def route_model(model: str, payload: dict) -> tuple[str, str]:
    """-> (destination, modèle effectif). Deux surfaces peuvent aller chez Anthropic."""
    model = model.removesuffix("[1m]")
    # La compaction se teste en premier, et sans regarder le modèle : quand le
    # chat principal est servi par GPT, elle arrive avec un nom `gpt-*`, et un
    # test conditionné au modèle ne la verrait jamais. On réécrit le modèle.
    if compaction_request(payload):
        return "anthropic", COMPACT_MODEL
    if MAIN_CHAT_UPSTREAM == "anthropic" and model == MAIN_MODEL and main_chat_request(payload):
        return "anthropic", model
    # Tout le reste part sur GPT, y compris les sub-agents qui héritent du modèle.
    return "proxy", gpt_model_for(model)


@dataclass
class UpstreamState:
    name: str
    port: int
    permits: int
    inflight: int = 0
    successes: int = 0


class UpstreamScheduler:
    """FIFO proxy-account selection with per-account adaptive concurrency."""

    def __init__(self, upstreams: list[dict], initial_permits: int = INITIAL_PERMITS) -> None:
        if not upstreams:
            raise ValueError("at least one proxy upstream is required")
        self._condition = threading.Condition()
        self._upstreams = [
            UpstreamState(str(upstream["name"]), int(upstream["port"]), initial_permits)
            for upstream in upstreams
        ]
        self._tickets: list[int] = []
        self._next_ticket = 0

    def acquire(
        self,
        avoid_name: str | None = None,
        timeout: float = ACQUIRE_TIMEOUT_SECONDS,
        only_name: str | None = None,
    ) -> UpstreamState:
        deadline = time.monotonic() + timeout
        with self._condition:
            ticket = self._next_ticket
            self._next_ticket += 1
            self._tickets.append(ticket)
            try:
                while True:
                    available = [
                        upstream for upstream in self._upstreams
                        if upstream.inflight < upstream.permits
                    ]
                    if only_name is not None:
                        candidates = [upstream for upstream in available if upstream.name == only_name]
                    elif avoid_name is not None:
                        candidates = [upstream for upstream in available if upstream.name != avoid_name]
                    else:
                        candidates = available
                    if self._tickets[0] == ticket and candidates:
                        upstream = max(
                            candidates,
                            key=lambda item: (item.permits - item.inflight, -item.inflight),
                        )
                        upstream.inflight += 1
                        self._tickets.pop(0)
                        self._condition.notify_all()
                        return upstream
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise TimeoutError("timed out waiting for proxy capacity")
                    self._condition.wait(remaining)
            finally:
                if ticket in self._tickets:
                    self._tickets.remove(ticket)
                    self._condition.notify_all()

    def has_available_alternative(self, name: str) -> bool:
        with self._condition:
            return any(
                upstream.name != name and upstream.inflight < upstream.permits
                for upstream in self._upstreams
            )

    def select_unlimited(self, only_name: str | None = None) -> UpstreamState:
        """Select an upstream without consuming a generation permit."""
        with self._condition:
            candidates = [
                upstream for upstream in self._upstreams
                if only_name is None or upstream.name == only_name
            ]
            if not candidates:
                raise ValueError(f"unknown proxy upstream: {only_name}")
            return max(candidates, key=lambda item: (item.permits - item.inflight, -item.inflight))

    def release(self, upstream: UpstreamState) -> None:
        with self._condition:
            upstream.inflight -= 1
            self._condition.notify_all()

    def websocket_rejected(self, upstream: UpstreamState) -> None:
        with self._condition:
            upstream.permits = max(MIN_PERMITS, int(upstream.permits * AIMD_DECREASE_FACTOR))
            upstream.successes = 0
            self._condition.notify_all()

    def succeeded(self, upstream: UpstreamState) -> None:
        with self._condition:
            upstream.successes += 1
            if upstream.successes >= SUCCESS_WINDOW:
                upstream.permits = max(upstream.permits, min(upstream.permits + 1, MAX_PERMITS))
                upstream.successes = 0
                self._condition.notify_all()

    def failed(self, upstream: UpstreamState) -> None:
        with self._condition:
            upstream.successes = 0

    def snapshot(self) -> list[dict]:
        with self._condition:
            return [
                {
                    "name": upstream.name,
                    "port": upstream.port,
                    "permits": upstream.permits,
                    "inflight": upstream.inflight,
                    "free": max(0, upstream.permits - upstream.inflight),
                    "successes": upstream.successes,
                }
                for upstream in self._upstreams
            ]


class RouterServer(ThreadingHTTPServer):
    daemon_threads = True

    def __init__(
        self,
        server_address: tuple[str, int],
        upstreams: list[dict],
        *,
        initial_permits: int = INITIAL_PERMITS,
        anthropic_connection_factory: Callable[[], http.client.HTTPConnection] | None = None,
        retry_sleeper: Callable[[float], None] = time.sleep,
        jitter_source: Callable[[], float] = random.random,
        route_logger: Callable[[str], object] = sys.stderr.write,
        proxy_connection_factory: Callable[[int], http.client.HTTPConnection] | None = None,
        delegate_port: int | None = None,
        pinned_upstream: str | None = None,
    ) -> None:
        self.scheduler = UpstreamScheduler(upstreams, initial_permits)
        self.delegate_port = delegate_port
        self.pinned_upstream = pinned_upstream
        self.anthropic_connection_factory = anthropic_connection_factory or (
            lambda: http.client.HTTPSConnection(ANTHROPIC_HOST, timeout=600)
        )
        self.retry_sleeper = retry_sleeper
        self.jitter_source = jitter_source
        self.route_logger = route_logger
        self.proxy_connection_factory = proxy_connection_factory or (
            lambda port: http.client.HTTPConnection("127.0.0.1", port, timeout=600)
        )
        super().__init__(server_address, RouterHandler)


class UpstreamStreamError(Exception):
    pass


class RouterHandler(BaseHTTPRequestHandler):
    # HTTP/1.0 + Connection: close — réponses délimitées par EOF, streaming SSE
    # relayé chunk par chunk sans ré-encodage.
    protocol_version = "HTTP/1.0"

    def setup(self) -> None:
        super().setup()
        self.connection.settimeout(SOCKET_READ_TIMEOUT_SECONDS)
        self._downstream_committed = False

    def _relay(self) -> None:
        if self.path == "/__clg":
            upstreams = self.server.scheduler.snapshot()
            payload = json.dumps(
                {
                    "router": "ok",
                    "main": MAIN_MODEL,
                    "upstreams": upstreams,
                    "delegate_port": self.server.delegate_port,
                    "pinned_upstream": self.server.pinned_upstream,
                },
                sort_keys=True,
            ).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return

        content_length = self.headers.get("Content-Length")
        if content_length is None:
            length = 0
        elif not content_length.isascii() or not content_length.isdecimal():
            self._error(400, "clg-router: Content-Length invalide")
            return
        else:
            length = int(content_length)
        if length > MAX_REQUEST_BODY_BYTES:
            self._error(413, "clg-router: corps de requête trop volumineux")
            return
        try:
            body = self.rfile.read(length) if length else b""
        except TimeoutError:
            self._error(408, "clg-router: lecture de requête expirée")
            return
        if self.server.delegate_port is not None:
            self._relay_delegate(body)
            return
        target = "proxy"
        route_details: tuple[str, list[str]] | None = None
        fallback: dict[str, object] | None = None
        if body:
            try:
                payload = json.loads(body)
            except Exception:
                payload = None
            if isinstance(payload, dict) and isinstance(payload.get("model"), str):
                requested = payload["model"]
                target, model = route_model(requested, payload)
                display_model = requested if model == requested else f"{requested} -> {model}"
                route_details = (display_model, [block[:50] for block in system_blocks(payload)[:3]])
                if model != requested:
                    payload["model"] = model
                    body = json.dumps(payload).encode()
                # Une compaction ne doit jamais échouer : si Anthropic est à bout
                # de quota ou surchargé, on la sert en GPT plutôt que de casser
                # la session. On prépare le corps de repli tant qu'on a le payload.
                if target == "anthropic" and compaction_request(payload):
                    degraded = gpt_model_for(requested.removesuffix("[1m]"))
                    fallback = {
                        "model": degraded,
                        "body": json.dumps(dict(payload, model=degraded)).encode(),
                    }

        headers = self._forward_headers(target, body)
        pinned_upstream = self.headers.get(PINNED_UPSTREAM_HEADER)
        if target == "anthropic":
            token = oauth_token()
            if not token:
                if fallback is not None:
                    self._compaction_fallback(fallback, route_details, "OAuth Anthropic introuvable")
                    return
                self._error(502, "clg-router: OAuth Anthropic introuvable (Keychain 'Claude Code-credentials'). Lance `claude` une fois pour te ré-authentifier.")
                return
            headers["authorization"] = f"Bearer {token}"
            beta = headers.pop("anthropic-beta", None) or headers.pop("Anthropic-Beta", None)
            headers["anthropic-beta"] = f"{beta},{OAUTH_BETA}" if beta and OAUTH_BETA not in beta else (beta or OAUTH_BETA)
            self._relay_anthropic(body, headers, route_details, token, fallback)
            return
        self._relay_proxy(body, headers, route_details, pinned_upstream)

    def _forward_headers(self, target: str, body: bytes) -> dict[str, str]:
        headers = {}
        for key, value in self.headers.items():
            low = key.lower()
            if low in ("host", "content-length", "connection", "transfer-encoding", "accept-encoding", "keep-alive", PINNED_UPSTREAM_HEADER.lower()):
                continue
            if target == "anthropic" and low in ("authorization", "x-api-key"):
                continue
            headers[key] = value
        if body:
            headers["Content-Length"] = str(len(body))
        return headers

    def _log_route(
        self,
        target: str,
        route_details: tuple[str, list[str]] | None,
        upstream: str,
        attempt: int,
    ) -> None:
        if route_details is None:
            return
        display_model, system = route_details
        self.server.route_logger(
            "route %-9s %-22s sys=%r upstream=%s attempt=%d\n"
            % (target, display_model, system, upstream, attempt)
        )

    def _compaction_fallback(
        self,
        fallback: dict[str, object],
        route_details: tuple[str, list[str]] | None,
        reason: str,
    ) -> None:
        """Dernier recours : servir la compaction en GPT au lieu d'échouer.

        La compaction est censée être servie par Claude — c'est la tâche pour
        laquelle il est entraîné. Ce chemin est une dégradation, pas un mode de
        fonctionnement : il est journalisé explicitement pour rester visible.
        """
        body = fallback["body"]
        self.server.route_logger(
            "compaction degradee (%s) -> proxy %s\n" % (reason, fallback["model"])
        )
        details = None
        if route_details is not None:
            details = (f"COMPACTION degradee -> {fallback['model']}", route_details[1])
        self._relay_proxy(
            body,
            self._forward_headers("proxy", body),
            details,
            self.headers.get(PINNED_UPSTREAM_HEADER),
        )

    def _relay_anthropic(
        self,
        body: bytes,
        headers: dict[str, str],
        route_details: tuple[str, list[str]] | None,
        token: str,
        fallback: dict[str, object] | None = None,
    ) -> None:
        # Une compaction insiste auprès d'Anthropic avant de se dégrader : le
        # 429 est souvent transitoire, et basculer au premier refus reviendrait
        # à abandonner Opus pour rien.
        attempts = COMPACTION_ANTHROPIC_ATTEMPTS if fallback is not None else 1
        response = None
        for attempt in range(1, attempts + 1):
            conn = self.server.anthropic_connection_factory()
            self._log_route("anthropic", route_details, ANTHROPIC_HOST, attempt)
            try:
                conn.request(self.command, self.path, body=body or None, headers=headers)
                response = conn.getresponse()
            except Exception as exc:
                conn.close()
                if fallback is not None:
                    self._compaction_fallback(fallback, route_details, f"injoignable: {exc}")
                    return
                self._error(502, f"clg-router: upstream anthropic injoignable: {exc}")
                return
            if response.status == 401:
                invalidate_oauth_token(token)
            if fallback is None or response.status not in COMPACTION_FALLBACK_STATUSES:
                try:
                    self._send_response(response)
                finally:
                    conn.close()
                return
            conn.close()
            if attempt < attempts:
                self.server.retry_sleeper(RETRY_BASE_SECONDS * attempt)
        self._compaction_fallback(
            fallback, route_details, f"anthropic {response.status if response else '???'}"
        )

    def _relay_delegate(self, body: bytes) -> None:
        """Compatibility listener which delegates pinning to the shared scheduler."""
        headers = self._forward_headers("proxy", body)
        headers[PINNED_UPSTREAM_HEADER] = self.server.pinned_upstream
        conn = self.server.proxy_connection_factory(self.server.delegate_port)
        try:
            conn.request(self.command, self.path, body=body or None, headers=headers)
            self._send_response(conn.getresponse())
        except UpstreamStreamError:
            if not self._downstream_committed:
                self._error(502, "clg-router: flux proxy tronqué")
        except Exception as exc:
            if not self._downstream_committed:
                self._error(502, f"clg-router: routeur partagé injoignable: {exc}")
        finally:
            conn.close()

    def _is_generation_request(self) -> bool:
        return self.command == "POST" and self.path == "/v1/messages"

    def _relay_proxy(
        self,
        body: bytes,
        headers: dict[str, str],
        route_details: tuple[str, list[str]] | None,
        pinned_upstream: str | None,
    ) -> None:
        generation = self._is_generation_request()
        avoid_name = None
        for attempt in range(1, MAX_PROXY_ATTEMPTS + 1):
            try:
                upstream = self.server.scheduler.acquire(
                    avoid_name=avoid_name,
                    only_name=pinned_upstream,
                ) if generation else self.server.scheduler.select_unlimited(pinned_upstream)
            except TimeoutError as exc:
                self._error(503, f"clg-router: capacité proxy indisponible: {exc}")
                return
            retry = False
            conn = None
            try:
                conn = self.server.proxy_connection_factory(upstream.port)
                self._log_route("proxy", route_details, upstream.name, attempt)
                conn.request(self.command, self.path, body=body or None, headers=headers)
                response = conn.getresponse()
                if response.status == 403:
                    content_length = response.getheader("Content-Length")
                    if content_length is not None and content_length.isdecimal() and int(content_length) > RETRY_BODY_LIMIT:
                        self._send_response(response)
                        if generation:
                            self.server.scheduler.failed(upstream)
                    else:
                        buffered = response.read(RETRY_BODY_LIMIT + 1)
                        rejected = len(buffered) <= RETRY_BODY_LIMIT and b"WebSocket upgrade" in buffered
                        if rejected and generation:
                            self.server.scheduler.websocket_rejected(upstream)
                            if (
                                attempt < MAX_PROXY_ATTEMPTS
                                and pinned_upstream is None
                                and self.server.scheduler.has_available_alternative(upstream.name)
                            ):
                                retry = True
                                avoid_name = upstream.name
                            else:
                                self._send_response(response, buffered)
                        else:
                            self._send_response(response, buffered)
                            if generation:
                                self.server.scheduler.failed(upstream)
                else:
                    completed = self._send_response(response)
                    if generation:
                        if completed and response.status < 400:
                            self.server.scheduler.succeeded(upstream)
                        else:
                            self.server.scheduler.failed(upstream)
            except UpstreamStreamError as exc:
                if generation:
                    self.server.scheduler.failed(upstream)
                if not self._downstream_committed:
                    self._error(502, f"clg-router: flux proxy @{upstream.name} tronqué: {exc}")
                return
            except Exception as exc:
                if generation:
                    self.server.scheduler.failed(upstream)
                if not self._downstream_committed:
                    self._error(502, f"clg-router: upstream proxy @{upstream.name} injoignable: {exc}")
                return
            finally:
                try:
                    if conn is not None:
                        conn.close()
                except Exception:
                    pass
                finally:
                    if generation:
                        self.server.scheduler.release(upstream)
            if not retry:
                return
            delay = RETRY_BASE_SECONDS * (2 ** (attempt - 1)) + self.server.jitter_source() * RETRY_JITTER_SECONDS
            self.server.retry_sleeper(delay)

    def _send_response(self, response: http.client.HTTPResponse, buffered: bytes = b"") -> bool:
        self.send_response(response.status)
        for key, value in response.getheaders():
            if key.lower() in ("transfer-encoding", "connection", "content-length", "keep-alive"):
                continue
            self.send_header(key, value)
        self.send_header("Connection", "close")
        self.end_headers()
        self._downstream_committed = True
        if buffered:
            try:
                self.wfile.write(buffered)
                self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                return False
        while True:
            try:
                chunk = response.read1(65536)
            except (http.client.IncompleteRead, ConnectionResetError, OSError) as exc:
                raise UpstreamStreamError(str(exc)) from exc
            if not chunk:
                return True
            try:
                self.wfile.write(chunk)
                self.wfile.flush()
            except (BrokenPipeError, ConnectionResetError):
                return False

    def _error(self, status: int, message: str) -> None:
        if self._downstream_committed:
            return
        payload = json.dumps({"type": "error", "error": {"type": "api_error", "message": message}}).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = _relay

    def log_message(self, fmt, *args):  # journal minimal dans le log du routeur
        if getattr(self.server, "suppress_logs", False):
            return
        sys.stderr.write("%s %s\n" % (self.log_date_time_string(), fmt % args))


def run_router(
    listen_port: int,
    upstreams: list[dict],
    *,
    delegate_port: int | None = None,
    pinned_upstream: str | None = None,
) -> None:
    server = RouterServer(
        ("127.0.0.1", listen_port), upstreams,
        delegate_port=delegate_port,
        pinned_upstream=pinned_upstream,
    )
    server.serve_forever()


def router_status(port: int) -> dict | None:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/__clg", timeout=2) as response:
            if response.status != 200:
                return None
            payload = json.loads(response.read())
            return payload if payload.get("router") == "ok" and payload.get("main") == MAIN_MODEL else None
    except Exception:
        return None


def router_healthy(
    port: int,
    expected_upstreams: list[dict] | None = None,
    *,
    delegate_port: int | None = None,
    pinned_upstream: str | None = None,
) -> bool:
    status = router_status(port)
    if status is None:
        return False
    if status.get("delegate_port") != delegate_port or status.get("pinned_upstream") != pinned_upstream:
        return False
    if expected_upstreams is None:
        return True
    actual = {(item.get("name"), item.get("port")) for item in status.get("upstreams", [])}
    expected = {(str(item["name"]), int(item["port"])) for item in expected_upstreams}
    return actual == expected


def router_listener_pid(port: int) -> int | None:
    try:
        result = subprocess.run(
            ["lsof", "-nP", f"-iTCP:{port}", "-sTCP:LISTEN", "-t"],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if result.returncode != 0:
            return None
        return int(result.stdout.splitlines()[0])
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        return None


def replace_stale_router(port: int) -> bool:
    """Stop only a listener proven to be this clg script's router process."""
    pid = router_listener_pid(port)
    if pid is None:
        return True
    try:
        command = subprocess.run(
            ["ps", "-p", str(pid), "-o", "command="],
            capture_output=True,
            text=True,
            timeout=2,
        ).stdout
        if os.path.realpath(__file__) not in command or " __router " not in command:
            return False
        os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            if router_listener_pid(port) is None:
                return True
            time.sleep(0.1)
    except (OSError, subprocess.SubprocessError):
        return False
    return False


def start_router(
    name: str,
    listen_port: int,
    upstreams: list[dict],
    *,
    delegate_port: int | None = None,
    pinned_upstream: str | None = None,
) -> bool:
    if router_healthy(
        listen_port, upstreams,
        delegate_port=delegate_port,
        pinned_upstream=pinned_upstream,
    ):
        return True
    if router_listener_pid(listen_port) is not None and not replace_stale_router(listen_port):
        return False
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(STATE_DIR / f"clg-router-{name}.log", "a") as log:
        subprocess.Popen(
            [
                sys.executable, os.path.realpath(__file__), "__router", str(listen_port), json.dumps(upstreams),
                json.dumps({"delegate_port": delegate_port, "pinned_upstream": pinned_upstream}),
            ],
            stdout=log, stderr=log, start_new_session=True,
        )
    for _ in range(20):
        if router_healthy(listen_port, upstreams):
            return True
        time.sleep(0.25)
    return False


# ---------------------------------------------------------------------------
# Proxy Codex (inchangé) + lanceur.
# ---------------------------------------------------------------------------

def proxy_healthy(port: int) -> bool:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/v1/models", timeout=2) as r:
            catalog = r.read().decode()
    except Exception:
        return False
    return all(m in catalog for m in (f'"{SOL}"', f'"{TERRA}"', f'"{LUNA}"'))


def start_proxy(name: str, acc: dict) -> bool:
    port = acc["port"]
    if proxy_healthy(port):
        return True
    # `brew` est vrai par défaut pour le compte "a" (cf. DEFAULT_ACCOUNTS) et se propage aussi
    # via un accounts.json copié depuis un Mac. Sans le which(), subprocess lève FileNotFoundError
    # sur toute machine sans Homebrew et clg meurt avant même d'essayer PROXY_BIN, qui lui est là.
    if acc.get("brew") and shutil.which("brew"):
        subprocess.run(
            ["brew", "services", "restart", BREW_FORMULA],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    if not proxy_healthy(port) and os.access(PROXY_BIN, os.X_OK):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        env = dict(os.environ, CCP_CONFIG_DIR=acc["dir"])
        with open(STATE_DIR / f"clg-{name}.log", "a") as log:
            subprocess.Popen(
                [PROXY_BIN, "serve", "--no-monitor", "--port", str(port)],
                stdout=log, stderr=log, env=env, start_new_session=True,
            )
    for _ in range(40):
        if proxy_healthy(port):
            return True
        time.sleep(0.25)
    return False


def has_auth(acc: dict) -> bool:
    return (pathlib.Path(acc["dir"]) / "codex" / "auth.json").exists()


def print_status(reg: dict) -> None:
    oauth = read_oauth()
    expires = oauth.get("expiresAt", 0)
    if not oauth.get("accessToken"):
        print("OAuth Anthropic (chat opus) : ABSENT — lance `claude` une fois pour t'authentifier")
    else:
        state = "valide" if expires / 1000 > time.time() else "EXPIRÉ — lance `claude` une fois pour le rafraîchir"
        print(f"OAuth Anthropic (chat opus) : {state} · plan {oauth.get('subscriptionType', '?')}")
    shared_status = router_status(SHARED_ROUTER_PORT)
    if shared_status:
        upstream_summary = ", ".join(
            f"@{item['name']} {item['inflight']}/{item['permits']}"
            for item in shared_status.get("upstreams", [])
        )
        print(f"@auto port {SHARED_ROUTER_PORT}  routeur partagé UP ({upstream_summary})")
    else:
        print(f"@auto port {SHARED_ROUTER_PORT}  routeur partagé down (démarré à la demande)")
    for name, acc in sorted(reg.items()):
        health = "proxy UP" if proxy_healthy(acc["port"]) else "proxy down (démarré à la demande)"
        rport = acc["port"] + ROUTER_PORT_OFFSET
        status = router_status(rport)
        if status:
            upstream_summary = ", ".join(
                f"@{item['name']} {item['inflight']}/{item['permits']}"
                for item in status.get("upstreams", [])
            )
            router = f"routeur UP ({upstream_summary})"
        else:
            router = "routeur down (démarré à la demande)"
        out = subprocess.run(
            [PROXY_BIN, "codex", "auth", "status"],
            capture_output=True, text=True,
            env=dict(os.environ, CCP_CONFIG_DIR=acc["dir"]),
        )
        auth = " · ".join(line.strip() for line in out.stdout.splitlines()[:2]) or out.stderr.strip()
        if not has_auth(acc) and not acc.get("brew"):
            auth = f"NON AUTHENTIFIÉ (clg-account add {name}) — attention: fallback silencieux sur le compte par défaut"
        print(f"@{name}  port {acc['port']}  {health}  ·  port {rport}  {router}\n    {auth}")


def resolve_claude_bin() -> str:
    override = os.environ.get("CLG_CLAUDE_BIN_OVERRIDE")
    candidates = [override] if override else []
    which = shutil.which("claude")
    if which:
        candidates.append(which)
    candidates += [str(HOME / ".local/bin/claude"), "/opt/homebrew/bin/claude", "/usr/local/bin/claude"]
    for c in candidates:
        if c and os.access(c, os.X_OK):
            return os.path.realpath(c)
    sys.exit("clg: Claude Code est introuvable. Définissez CLG_CLAUDE_BIN_OVERRIDE si nécessaire.")


def main() -> None:
    args = sys.argv[1:]

    if args and args[0] == "__router":
        options = json.loads(args[3]) if len(args) > 3 else {}
        run_router(int(args[1]), json.loads(args[2]), **options)
        return

    reg = load_registry()

    selector = os.environ.get("CLG_ACCOUNT", "")
    if args and args[0].startswith("@"):
        selector = args[0][1:]
        args = args[1:]

    if selector in ("list", "status"):
        print_status(reg)
        return

    explicit_selector = bool(selector)
    if not selector:
        selector = "auto"
    shared = selector == "auto"
    if not shared and selector not in reg:
        other = load_registry(kind=None).get(selector)
        if other:
            sys.exit(
                f"clg: @{selector} est un compte {other.get('kind')}, pas un upstream proxy. "
                f"clg ne route que les comptes proxy — vois `clgctl status`."
            )
        sys.exit(
            f"clg: compte inconnu '@{selector}'. Comptes: "
            + ", ".join("@" + name for name in sorted(reg))
            + f". Ajouter: clg-account add {selector}"
        )

    selected = [(name, acc) for name, acc in sorted(reg.items()) if has_auth(acc)]
    if not selected:
        sys.exit("clg: aucun compte claude-code-proxy authentifié. Lance `clg-account add <nom>`.")
    if not shared and selector not in {name for name, _acc in selected}:
        sys.exit(f"clg: compte @{selector} non authentifié. Lance `clg-account add {selector}`.")
    failed = [name for name, acc in selected if not start_proxy(name, acc)]
    if failed:
        # proxy_healthy() exige que SOL/TERRA/LUNA figurent au catalogue du proxy :
        # un modèle inconnu dans routing.json ressort donc ici, et pas comme une
        # erreur de configuration. On le dit, sinon la piste est introuvable.
        sys.exit(
            "clg: proxy non sain pour " + ", ".join("@" + name for name in failed)
            + f". Logs: {STATE_DIR}/clg-<compte>.log\n"
            + f"clg: vérifie aussi que le proxy sert bien {SOL}, {TERRA} et {LUNA} "
            + "(`clgctl config show`)."
        )
    upstreams = [{"name": name, "port": acc["port"]} for name, acc in selected]
    if not start_router("shared", SHARED_ROUTER_PORT, upstreams):
        sys.exit(
            f"clg: routeur partagé n'est pas sain sur le port {SHARED_ROUTER_PORT}.\n"
            f"clg: log: {STATE_DIR}/clg-router-shared.log"
        )
    if shared:
        rport = SHARED_ROUTER_PORT
        print("clg: routeur partagé " + ", ".join(f"@{item['name']}:{item['port']}" for item in upstreams), file=sys.stderr)
    else:
        acc = reg[selector]
        rport = acc["port"] + ROUTER_PORT_OFFSET
        if not start_router(
            selector, rport, upstreams,
            delegate_port=SHARED_ROUTER_PORT,
            pinned_upstream=selector,
        ):
            sys.exit(f"clg: relais @{selector} indisponible sur le port {rport}.")
        print(f"clg: compte @{selector} via routeur partagé (port {rport})", file=sys.stderr)

    oauth = read_oauth()
    if not oauth.get("accessToken"):
        print("clg: ATTENTION — OAuth Anthropic absent : le chat opus échouera. Lance `claude` une fois.", file=sys.stderr)
    elif oauth.get("expiresAt", 0) / 1000 < time.time():
        print("clg: ATTENTION — OAuth Anthropic expiré : lance `claude` une fois pour le rafraîchir.", file=sys.stderr)

    # Les surcharges par compte se résolvent ICI : c'est l'environnement passé à
    # Claude Code qui décide du modèle envoyé. Le routeur partagé sert plusieurs
    # comptes et ne peut pas les distinguer par requête ; il ne fait que traduire
    # les alias (`opus`, `fable`…) avec les tiers de base.
    routing = load_routing(None if shared else selector)
    main_model_env = routing["main_model_env"]
    sol, terra, luna = (routing["tiers"][tier] for tier in ("opus", "sonnet", "haiku"))

    env = os.environ.copy()
    # Tiers explicites : le chat reste sur un vrai Opus Anthropic (compaction et
    # harness natifs), tous les sub-agents partent sur les modèles GPT du proxy.
    for var in (
        "ANTHROPIC_API_KEY", "CLAUDE_MODEL", "CLAUDE_CODE_SUBAGENT_MODEL",
        "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE", "CLAUDE_CODE_AUTO_COMPACT_WINDOW",
        "DISABLE_AUTO_COMPACT", "DISABLE_COMPACT",
        "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX",
        # Purgée puis réexportée seulement en mode GPT : une valeur héritée du
        # shell clamperait la fenêtre 1M du chat Opus.
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS",
    ):
        env.pop(var, None)
    env.update(
        ANTHROPIC_BASE_URL=f"http://127.0.0.1:{rport}",
        ANTHROPIC_AUTH_TOKEN="unused",
        ANTHROPIC_MODEL=main_model_env,
        ANTHROPIC_DEFAULT_OPUS_MODEL=sol,
        ANTHROPIC_DEFAULT_SONNET_MODEL=terra,
        ANTHROPIC_DEFAULT_HAIKU_MODEL=luna,
        ANTHROPIC_SMALL_FAST_MODEL=luna,
        CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS="0",
        CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1",
        CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK="1",
    )
    if routing["main_chat"] == "gpt" and routing["main_context_tokens"].strip():
        env["CLAUDE_CODE_MAX_CONTEXT_TOKENS"] = routing["main_context_tokens"]
    # Purgée plus haut puis réexportée ici : une valeur héritée du shell ferait
    # compacter à un seuil qu'on n'a pas choisi, ce qui est exactement le
    # symptôme qu'on cherche à contrôler.
    if routing["autocompact_pct"].strip():
        env["CLAUDE_AUTOCOMPACT_PCT_OVERRIDE"] = routing["autocompact_pct"].strip()

    # Le bandeau doit dire la vérité sur le mode courant : annoncer « Anthropic
    # réel » alors que le chat tourne sur GPT rendrait toute erreur de config
    # invisible au lancement, là où elle est le moins chère à corriger.
    if routing["main_chat"] == "anthropic":
        chat_desc = f"chat={main_model_env} (Anthropic réel, contexte 1M)"
    else:
        chat_desc = f"chat={main_model_env} (GPT via proxy)"
    print(
        f"clg: {chat_desc} · compaction={routing['compact_model']} (Anthropic)"
        f" · routeur={'partagé' if shared else '@' + selector}"
        f" · sub-agents GPT: opus/fable→{sol}, sans modèle/sonnet→{terra}, haiku→{luna}",
        file=sys.stderr,
    )

    # Keep teammates in this process so they inherit the proxy authentication and
    # tier mappings exactly. Print mode is headless: Remote Control's first-party
    # WebSocket is both unnecessary and incompatible with the proxy auth token.
    launch = ["--teammate-mode", "in-process", "--dangerously-skip-permissions"]
    if not any(a in ("-p", "--print") for a in args):
        launch = ["--remote-control", *launch]

    claude = resolve_claude_bin()
    os.execve(claude, [claude, *launch, *args], env)


if __name__ == "__main__":
    main()
